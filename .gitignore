node_modules/
client/node_modules/
server/node_modules/
compression-service/node_modules/
compression-service/client/node_modules/
rag-service/venv/
rag-service/.venv/

# ==========================================
# Environment Variables
# ==========================================
.env
*.env
client/.env
server/.env
compression-service/.env
compression-service/client/.env
rag-service/.env

# ==========================================
# Server Uploads, Vector DB & Local Media Storage
# ==========================================
server/uploads/*
