# ==========================================
dist/
build/
client/dist/
compression-service/dist/
compression-service/client/dist/
rag-service/frontend/dist/
__pycache__/
*.py[cod]
*$py.class
npm-debug.log*
yarn-debug.log*
yarn-error.log*

